{
  "name": "bof2-rekindled",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Breath of Fire II: Rekindled — Mobile-First Open-World HD-2D RPG",
  "scripts": {
    "dev": "vite --port 5173 --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 5173 --host",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "cap:sync": "tsc --noEmit && vite build && cap sync",
    "cap:ios": "cap open ios",
    "cap:android": "cap open android",
    "audit:bundle": "node scripts/audit-bundle.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.2",
    "@capacitor/screen-orientation": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@react-three/fiber": "^8.17.10",
    "miniplex": "^2.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.7",
    "vitest": "^2.1.0"
  }
}
